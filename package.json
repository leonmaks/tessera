{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "openspec:init": "openspec init . --tools codex",
    "openspec:update": "openspec update",
    "openspec:validate": "openspec validate --all",
    "baseline:pin": "node scripts/pin-logseq-baseline.mjs",
    "baseline:run": "node scripts/run-pinned-upstream.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:phase-gate": "node scripts/phase-quality-gate.mjs --audit",
    "phase:pre": "node scripts/phase-quality-gate.mjs --pre",
    "phase:post": "node scripts/phase-quality-gate.mjs --post",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ./scripts/windows-user-info-shim.cjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --require ./scripts/windows-user-info-shim.cjs ./node_modules/vitest/vitest.mjs",
    "test:property": "node --require ./scripts/windows-user-info-shim.cjs ./node_modules/vitest/vitest.mjs run tests/property",
    "test:parity": "node --require ./scripts/windows-user-info-shim.cjs ./node_modules/vitest/vitest.mjs run tests/parity",
    "test:bdd": "node --require ./scripts/windows-user-info-shim.cjs --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
    "test:e2e": "node --require ./scripts/windows-user-info-shim.cjs ./node_modules/@playwright/test/cli.js test",
    "build:web": "node --require ./scripts/windows-user-info-shim.cjs ./node_modules/vite/bin/vite.js build apps/web --config vite.config.ts",
    "dev:desktop": "pnpm build:desktop && electron dist/desktop/main.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package:desktop": "pnpm build:desktop && node scripts/package-desktop.mjs",
    "test:desktop": "node --require ./scripts/windows-user-info-shim.cjs ./node_modules/@playwright/test/cli.js test --config playwright.electron.config.ts",
    "dev:web": "node --require ./scripts/windows-user-info-shim.cjs ./node_modules/vite/bin/vite.js apps/web --config vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "verify": "pnpm check:boundaries && pnpm check:specs && pnpm check:phase-gate && pnpm typecheck && pnpm test",
    "codex:next": "node scripts/next-phase.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@electron/packager": "20.3.0",
    "@fission-ai/openspec": "1.13.0",
    "@playwright/test": "1.58.2",
    "@tessera-ts/graph-worker": "workspace:*",
    "@types/node": "22.20.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.4.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.10",
    "vitest": "5.0.0",
    "zod": "4.6.2"
  },
  "dependencies": {
    "@tessera-ts/desktop-cli-runtime": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
